				end
				local pushDir = safeUnit(part.Position - curPos + Vector3.new(0, 3, 0), Vector3.yAxis)
				part.AssemblyLinearVelocity = pushDir * CONFIG.Gadgets.WebBombForce
			end
		end
	end)
