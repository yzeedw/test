local function triggerAbilityInput(abilityId, isPressed)
	if abilityId == "Swing" then
		if isPressed then startSwing() else stopSwing(true) end
	elseif abilityId == "Crawl" and isPressed then
		if State.IsCrawling then stopCrawl() else snapAndStartCrawl() end
	elseif abilityId == "WebZip" and isPressed then
		performWebZip()
	elseif abilityId == "Slingshot" then
		if isPressed then startSlingshotCharge() else releaseSlingshot() end
	elseif abilityId == "SuperJump" then
		if isPressed then startJumpCharge() else releaseJumpCharge() end
	elseif abilityId == "Acrobatics" and isPressed then
		if State.IsSwinging then
			stopSwing(true)
			if not SETTINGS.SwingFrontFlip then
				performBodyFlip("Front")
			end
		else
			performBodyFlip("Front")
		end
	elseif abilityId == "WebShoot" and isPressed then
		fireWebProjectile()
	elseif abilityId == "WebPull" and isPressed then
		performWebPull()
	elseif abilityId == "WebBomb" and isPressed then
		throwWebBomb()
	elseif abilityId == "WebShield" then
		toggleWebShield(isPressed)
	elseif abilityId == "VenomSmash" and isPressed then
		performVenomSmash()
	elseif abilityId == "WebBlossom" and isPressed then
		performWebBlossom()
	elseif abilityId == "SurgeMode" and isPressed then
		activateSurgeMode()
	elseif abilityId == "SpiderSense" and isPressed then
		performSpiderSenseDodge()
	elseif abilityId == "WebHang" and isPressed then
		toggleWebHang()
	elseif abilityId == "WebWings" and isPressed then
		toggleWebWings()
	elseif abilityId == "Combat" and isPressed then
		performCombatAttack()
	elseif abilityId == "Settings" and isPressed then
		toggleSettingsTab()
	elseif abilityId == "Cancel" and isPressed then
		cancelAllStates()
	end
end

