local function findClimbableSurface(customRange)
	if not RootPart then return nil end
	local origin = RootPart.Position
	local range = customRange or CONFIG.Crawl.DetectionDistance
	local params = getRayParams()

	local dirs = {
		RootPart.CFrame.LookVector,
		Camera.CFrame.LookVector,
		Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z),
		-RootPart.CFrame.UpVector,
		RootPart.CFrame.RightVector,
		-RootPart.CFrame.RightVector,
		-RootPart.CFrame.LookVector,
		Vector3.yAxis,
	}

	local bestHit = nil
	local bestDist = math.huge

	for _, d in ipairs(dirs) do
		if d.Magnitude > 0.05 then
			local hit = Workspace:Raycast(origin, d.Unit * range, params)
			if hit and hit.Instance and hit.Instance.CanCollide and hit.Normal.Y < 0.72 then
				local dist = (hit.Position - origin).Magnitude
				if dist < bestDist then
					bestDist = dist
					bestHit = hit
				end
			end
		end
	end

	return bestHit
end

local function stopCrawl()
	if not State.IsCrawling then return end
	State.IsCrawling = false

	stopAnim("WallCrawl", 0.15)

	if PhysicsObjects.CrawlLinearVelocity then
		PhysicsObjects.CrawlLinearVelocity.Enabled = false
		PhysicsObjects.CrawlLinearVelocity.VectorVelocity = Vector3.zero
	end
	if PhysicsObjects.CrawlAlignOrientation then
		PhysicsObjects.CrawlAlignOrientation.Enabled = false
	end

	makeCharacterUpright()
end

local function startCrawl(hitResult)
	if not RootPart or not Humanoid then return end
	stopSwing(false)
	stopBodyFlip()

	State.IsCrawling = true
	State.CrawlNormal = hitResult.Normal
	State.CrawlSurfacePos = hitResult.Position
	State.CanDoubleJump = true
	State.HasDoubleJumped = false
	State.AirZipCount = 0

	Humanoid.PlatformStand = false
	Humanoid.AutoRotate = false

	PhysicsObjects.CrawlLinearVelocity.VectorVelocity = Vector3.zero
	PhysicsObjects.CrawlLinearVelocity.Enabled = true
	PhysicsObjects.CrawlAlignOrientation.Enabled = true

	playWebSound(1.22)
	playAnim("WallCrawl", 0.15, 0)
end

local function snapAndStartCrawl()
	if not RootPart or not Humanoid then return end

	local closeHit = findClimbableSurface(CONFIG.Crawl.DetectionDistance)
	if closeHit then
		startCrawl(closeHit)
		return
	end

	local snapHit = findClimbableSurface(CONFIG.Crawl.SnapDistance)
	if snapHit then
		local targetPos = snapHit.Position + snapHit.Normal * 2.4
		local wristAtt = PhysicsObjects.RightWristAttachment or PhysicsObjects.RootAttachment
		local tempPart = Instance.new("Part")
		tempPart.Size = Vector3.new(0.2, 0.2, 0.2)
		tempPart.Position = snapHit.Position
		tempPart.Anchored = true
		tempPart.Transparency = 1
		tempPart.CanCollide = false
		tempPart.Parent = ensureVFXFolder()

		local tempAtt = Instance.new("Attachment")
		tempAtt.Parent = tempPart
		local beam = createWebBeam(wristAtt, tempAtt, 0.18, 0.10, CONFIG.Visuals.WebColor)
		playWebSound(1.18)
		spawnAnchorWebSplat(snapHit.Position, snapHit.Normal, true)

		TweenService:Create(RootPart, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = CFrame.lookAt(targetPos, targetPos - snapHit.Normal),
		}):Play()

		task.delay(0.16, function()
			if beam then beam:Destroy() end
			if tempPart then tempPart:Destroy() end
			if RootPart and Humanoid and Humanoid.Health > 0 then
				startCrawl(snapHit)
			end
		end)
	end
end

local function updateCrawlPhysics(dt)
	if not State.IsCrawling or not RootPart or not Humanoid then return end

	local pos = RootPart.Position
	local n = State.CrawlNormal
	local params = getRayParams()

	local forwardAxis, rightAxis = getRawInputAxes()
	local hasInput = (math.abs(forwardAxis) > 0.05 or math.abs(rightAxis) > 0.05)

	local camCF = Camera.CFrame
	local camUpOnWall = camCF.LookVector - n * camCF.LookVector:Dot(n)
	if camUpOnWall.Magnitude < 0.15 then
		camUpOnWall = camCF.UpVector - n * camCF.UpVector:Dot(n)
	end
	if camUpOnWall.Magnitude < 0.15 then
		camUpOnWall = Vector3.yAxis - n * Vector3.yAxis:Dot(n)
	end
	local wallUp = safeUnit(camUpOnWall, Vector3.yAxis)
	local wallRight = safeUnit(wallUp:Cross(n), Vector3.xAxis)
	wallUp = safeUnit(n:Cross(wallRight), Vector3.yAxis)

	local moveDirOnSurface = Vector3.zero
	if hasInput then
		moveDirOnSurface = safeUnit(wallUp * forwardAxis + wallRight * rightAxis, wallUp)
	end

	local surfaceHit = nil
	if hasInput then
		local insideHit = Workspace:Raycast(pos, moveDirOnSurface * 4.2, params)
		if insideHit and insideHit.Instance.CanCollide and insideHit.Normal.Y < 0.72 then
			surfaceHit = insideHit
		end
	end

	if not surfaceHit then
		surfaceHit = Workspace:Raycast(pos, -n * CONFIG.Crawl.DetectionDistance, params)
	end

	if not surfaceHit and hasInput then
		local wrapOrigin = pos + moveDirOnSurface * CONFIG.Crawl.CornerRayOffset - n * 1.6
		local wrapDir = (-n - moveDirOnSurface * 1.15).Unit
		local wrapHit = Workspace:Raycast(wrapOrigin, wrapDir * CONFIG.Crawl.CornerWrapDistance, params)
		if wrapHit and wrapHit.Instance.CanCollide and wrapHit.Normal.Y < 0.72 then
			surfaceHit = wrapHit
		end
	end

	if not surfaceHit then
		if hasInput and moveDirOnSurface.Y > 0.25 then
			local ledgeCheckOrigin = pos + Vector3.new(0, 3.6, 0) - n * 3.0
			local ledgeHit = Workspace:Raycast(ledgeCheckOrigin, Vector3.new(0, -6.5, 0), params)
			if ledgeHit and ledgeHit.Normal.Y >= 0.72 then
				local wallInward = safeUnit(Vector3.new(-n.X, 0, -n.Z), Vector3.new(0, 0, -1))
				stopCrawl()
				RootPart.AssemblyLinearVelocity = Vector3.new(0, CONFIG.Crawl.LedgeBoostUp, 0) + wallInward * CONFIG.Crawl.LedgeBoostForward
				playWhooshSound(1.15)
				performBodyFlip("Front")
				return
			end
		end
		stopCrawl()
		return
	end

	State.CrawlNormal = safeUnit(State.CrawlNormal:Lerp(surfaceHit.Normal, clamp(CONFIG.Crawl.NormalLerpSpeed * dt, 0, 1)), surfaceHit.Normal)
	State.CrawlSurfacePos = surfaceHit.Position
	n = State.CrawlNormal

	local isWallRunning = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
	local speed = isWallRunning and CONFIG.Crawl.WallRunSpeed or CONFIG.Crawl.CrawlSpeed
	if State.IsSurgeActive then
		speed = speed * CONFIG.Ultimates.SurgeSpeedMultiplier
	end

	local distToWall = (pos - surfaceHit.Position):Dot(n)
	local idealDist = 2.35
	local normalCorrectionVel = -n * ((distToWall - idealDist) * CONFIG.Crawl.AdhesionPullSpeed)

	if hasInput then
		PhysicsObjects.CrawlLinearVelocity.VectorVelocity = (moveDirOnSurface * speed) + normalCorrectionVel
		local facingLook = moveDirOnSurface
		local rightVec = safeUnit(facingLook:Cross(n), wallRight)
		local correctedLook = safeUnit(n:Cross(rightVec), facingLook)
		PhysicsObjects.CrawlAlignOrientation.CFrame = CFrame.fromMatrix(pos, rightVec, n, -correctedLook)
		playAnim("WallCrawl", 0.1, isWallRunning and 1.85 or 1.2)
	else
		PhysicsObjects.CrawlLinearVelocity.VectorVelocity = normalCorrectionVel
		local rightVec = safeUnit(wallUp:Cross(n), wallRight)
		local correctedLook = safeUnit(n:Cross(rightVec), wallUp)
		PhysicsObjects.CrawlAlignOrientation.CFrame = CFrame.fromMatrix(pos, rightVec, n, -correctedLook)
		playAnim("WallCrawl", 0.1, 0)
	end
end

