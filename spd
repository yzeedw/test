local function startSlingshotCharge()
	if not RootPart or not Humanoid or State.IsChargingSling then return end
	stopSwing(false)
	stopCrawl()
	stopWebHang()

	State.IsChargingSling = true
	State.SlingChargeStart = os.clock()

	local origin = RootPart.Position
	local camLook = safeUnit(Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z), Vector3.new(0, 0, -1))
	local camRight = camLook:Cross(Vector3.yAxis)
	local params = getRayParams()

	local leftRay = Workspace:Raycast(origin, (camLook * CONFIG.Slingshot.AnchorForwardDistance - camRight * CONFIG.Slingshot.AnchorSpread), params)
	local rightRay = Workspace:Raycast(origin, (camLook * CONFIG.Slingshot.AnchorForwardDistance + camRight * CONFIG.Slingshot.AnchorSpread), params)

	local leftPos = leftRay and leftRay.Position or (origin + camLook * 85 - camRight * CONFIG.Slingshot.AnchorSpread + Vector3.new(0, 16, 0))
	local rightPos = rightRay and rightRay.Position or (origin + camLook * 85 + camRight * CONFIG.Slingshot.AnchorSpread + Vector3.new(0, 16, 0))

	local lPart = Instance.new("Part")
	lPart.Size = Vector3.new(0.2, 0.2, 0.2)
	lPart.Position = leftPos
	lPart.Anchored = true
	lPart.CanCollide = false
	lPart.Transparency = 1
	lPart.Parent = ensureVFXFolder()
	local lAtt = Instance.new("Attachment", lPart)

	local rPart = Instance.new("Part")
	rPart.Size = Vector3.new(0.2, 0.2, 0.2)
	rPart.Position = rightPos
	rPart.Anchored = true
	rPart.CanCollide = false
	rPart.Transparency = 1
	rPart.Parent = ensureVFXFolder()
