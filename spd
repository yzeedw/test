			local step = aimDir * (CONFIG.Gadgets.WebShotSpeed * dt)
			local hit = Workspace:Raycast(curPos, step, params)
			if hit then
				spawnAnchorWebSplat(hit.Position, hit.Normal, true)
				playImpactSound(1.2)
