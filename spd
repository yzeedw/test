local function stopWebWings()
	if not State.IsGliding then return end
	State.IsGliding = false

	if PhysicsObjects.GlideLinearVelocity then
		PhysicsObjects.GlideLinearVelocity.Enabled = false
	end
	if PhysicsObjects.GlideAlignOrientation then
		PhysicsObjects.GlideAlignOrientation.Enabled = false
	end
	if PhysicsObjects.LeftWingBeam then PhysicsObjects.LeftWingBeam:Destroy() PhysicsObjects.LeftWingBeam = nil end
	if PhysicsObjects.RightWingBeam then PhysicsObjects.RightWingBeam:Destroy() PhysicsObjects.RightWingBeam = nil end
	if PhysicsObjects.SpeedTrailRight then PhysicsObjects.SpeedTrailRight.Enabled = false end
	if PhysicsObjects.SpeedTrailLeft then PhysicsObjects.SpeedTrailLeft.Enabled = false end

	makeCharacterUpright()
end

local function toggleWebWings()
	if State.IsGliding then
		stopWebWings()
		return
	end
	if not RootPart or not Humanoid or isGrounded() then return end

	stopSwing(false)
	stopCrawl()
	stopWebHang()
	stopBodyFlip()

	State.IsGliding = true
	Humanoid.AutoRotate = false
	PhysicsObjects.GlideLinearVelocity.Enabled = true
	PhysicsObjects.GlideAlignOrientation.Enabled = true

	if PhysicsObjects.LeftWristAttachment and PhysicsObjects.RootAttachment then
		PhysicsObjects.LeftWingBeam = createWebBeam(PhysicsObjects.LeftWristAttachment, PhysicsObjects.RootAttachment, 0.75, 1.35, CONFIG.Visuals.WebGlowColor)
	end
	if PhysicsObjects.RightWristAttachment and PhysicsObjects.RootAttachment then
		PhysicsObjects.RightWingBeam = createWebBeam(PhysicsObjects.RightWristAttachment, PhysicsObjects.RootAttachment, 0.75, 1.35, CONFIG.Visuals.WebGlowColor)
	end

	if PhysicsObjects.SpeedTrailRight then PhysicsObjects.SpeedTrailRight.Enabled = true end
	if PhysicsObjects.SpeedTrailLeft then PhysicsObjects.SpeedTrailLeft.Enabled = true end
	playWhooshSound(1.05)
end

local function updateWebWingsPhysics(dt)
	if not State.IsGliding or not RootPart or not Humanoid then return end
	if isGrounded() then
		stopWebWings()
		return
	end

	local camLook = Camera.CFrame.LookVector
	local pitch = clamp(camLook.Y, -0.75, 0.45)
	local speedMult = 1 + (-pitch * 0.45)
	local forwardSpeed = CONFIG.WebWings.ForwardGlideSpeed * speedMult * (State.IsSurgeActive and CONFIG.Ultimates.SurgeSpeedMultiplier or 1)
	local verticalVel = CONFIG.WebWings.DescentRate + (pitch * CONFIG.WebWings.PitchSensitivity)

	local flatLook = safeUnit(Vector3.new(camLook.X, 0, camLook.Z), Vector3.new(0, 0, -1))
	local glideVel = flatLook * forwardSpeed + Vector3.new(0, verticalVel, 0)

	PhysicsObjects.GlideLinearVelocity.VectorVelocity = glideVel
	PhysicsObjects.GlideAlignOrientation.CFrame = CFrame.lookAt(RootPart.Position, RootPart.Position + glideVel.Unit) * CFrame.Angles(math.rad(-68), 0, 0)
end

