local function performBodyFlip(flipStyle)
	if not RootPart or not Humanoid then return end
	if State.IsCrawling or State.IsHanging or State.IsGliding then return end

	State.IsFlipping = true
	playAnim("Flip", 0.05, 1.35)
	playSwooshSound(1.15)

	local align = PhysicsObjects.FlipAlignOrientation
	if not align then
		align = Instance.new("AlignOrientation")
		align.Name = "SpiderFlipAlign"
		align.Mode = Enum.OrientationAlignmentMode.OneAttachment
		align.Attachment0 = PhysicsObjects.RootAttachment
		align.RigidityEnabled = false
		align.MaxTorque = 950000
		align.Responsiveness = 55
		align.Enabled = false
		align.Parent = RootPart
		PhysicsObjects.FlipAlignOrientation = align
	end

	local vel = RootPart.AssemblyLinearVelocity
	local flatLook = Vector3.new(vel.X, 0, vel.Z)
	if flatLook.Magnitude < 4 then
		flatLook = Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z)
	end
	flatLook = safeUnit(flatLook, Vector3.new(0, 0, -1))
	local baseCF = CFrame.lookAt(Vector3.zero, flatLook, Vector3.yAxis)

	Humanoid.AutoRotate = false
	align.CFrame = baseCF
	align.Enabled = true

	local spinRing = Instance.new("Part")
	spinRing.Name = "FlipAirRing"
	spinRing.Size = Vector3.new(4.5, 0.25, 4.5)
	spinRing.Shape = Enum.PartType.Cylinder
	spinRing.Material = Enum.Material.Neon
	spinRing.Color = CONFIG.Visuals.WebGlowColor
	spinRing.Transparency = 0.45
	spinRing.Anchored = true
	spinRing.CanCollide = false
	spinRing.CanQuery = false
	spinRing.CanTouch = false
	spinRing.CFrame = RootPart.CFrame * CFrame.Angles(0, 0, math.rad(90))
	spinRing.Parent = ensureVFXFolder()

	TweenService:Create(spinRing, TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.05, 9.5, 9.5),
		Transparency = 1,
	}):Play()
	Debris:AddItem(spinRing, 0.45)

	local duration = 0.44
	local startTime = os.clock()
	local style = flipStyle or "Front"

	task.spawn(function()
		while State.IsFlipping and (os.clock() - startTime) < duration do
			if not RootPart or not RootPart.Parent then break end
			if State.IsSwinging or State.IsCrawling or State.IsHanging or State.IsGliding or State.IsWebZipping then
				break
			end
			local alpha = clamp((os.clock() - startTime) / duration, 0, 1)
			local angle = alpha * math.pi * 2

			local currentVel = RootPart.AssemblyLinearVelocity
			local curFlat = Vector3.new(currentVel.X, 0, currentVel.Z)
			if curFlat.Magnitude > 5 then
				baseCF = CFrame.lookAt(Vector3.zero, curFlat.Unit, Vector3.yAxis)
			end

			if style == "Front" then
				align.CFrame = baseCF * CFrame.Angles(-angle, 0, 0)
			elseif style == "Back" then
				align.CFrame = baseCF * CFrame.Angles(angle, 0, 0)
			elseif style == "SideRight" then
				align.CFrame = baseCF * CFrame.Angles(0, 0, -angle)
			elseif style == "SideLeft" then
				align.CFrame = baseCF * CFrame.Angles(0, 0, angle)
			else
				align.CFrame = baseCF * CFrame.Angles(-angle, 0, angle)
			end

			RunService.RenderStepped:Wait()
		end

		if align then
			align.CFrame = baseCF
			align.Enabled = false
		end
		State.IsFlipping = false
		if not State.IsSwinging and not State.IsCrawling and not State.IsHanging and not State.IsGliding then
			makeCharacterUpright()
		end
	end)
end

------------------------------------------------------------------------------------------------
-- SYSTEM 1: BALANCED SLIGHTLY-FAST PENDULUM WEB SWINGING (WITH BUILDING DETECTION SETTING)
------------------------------------------------------------------------------------------------
local function findBestSwingAnchor(previewOnly)
	if not RootPart then return nil, nil, false end

	local origin = RootPart.Position
	local vel = RootPart.AssemblyLinearVelocity
	local flatVel = Vector3.new(vel.X, 0, vel.Z)
	local camLook = Camera.CFrame.LookVector
	local flatCam = safeUnit(Vector3.new(camLook.X, 0, camLook.Z), Vector3.new(0, 0, -1))

	local forwardDir = (flatVel.Magnitude > 14) and safeUnit(flatVel:Lerp(flatCam * flatVel.Magnitude, 0.45), flatCam) or flatCam
	local rightDir = forwardDir:Cross(Vector3.yAxis)
	local params = getRayParams()

	local bestPos = nil
	local bestNormal = Vector3.yAxis
	local bestScore = -math.huge
	local isBuilding = false

	-- CHECK SETTING: Building Detection ON vs OFF
	if SETTINGS.BuildingDetection then
		-- 1. Direct Camera Look Raycast (if aiming above horizon at a building)
		if camLook.Y > 0.06 then
			local lookHit = Workspace:Raycast(origin, camLook * CONFIG.Swing.MaxRayDistance, params)
			if lookHit and lookHit.Position.Y > (origin.Y + CONFIG.Swing.MinAnchorHeightAbovePlayer) then
				local dist = (lookHit.Position - origin).Magnitude
				if dist >= 22 and dist <= CONFIG.Swing.MaxRayDistance then
					bestPos = lookHit.Position
					bestNormal = lookHit.Normal
					bestScore = 175 - math.abs(dist - CONFIG.Swing.IdealAnchorDistance) * 0.45
					isBuilding = true
				end
			end
		end

		-- 2. 32-Ray Smart Architectural Cone Search
		local numRays = CONFIG.Swing.ConeRays
		for i = 1, numRays do
			local frac = (i - 1) / (numRays - 1)
			local yaw = (frac - 0.5) * math.rad(130)
			local pitch = math.rad(22 + (i % 4) * 14)

			local horizontal = (forwardDir * math.cos(yaw) + rightDir * math.sin(yaw)).Unit
			local rayDir = (horizontal * math.cos(pitch) + Vector3.yAxis * math.sin(pitch)).Unit

			local hit = Workspace:Raycast(origin, rayDir * CONFIG.Swing.MaxRayDistance, params)
			if hit then
				local hitPos = hit.Position
				local heightGain = hitPos.Y - origin.Y
				local dist = (hitPos - origin).Magnitude
				local forwardAdvance = (hitPos - origin):Dot(forwardDir)

				if heightGain >= CONFIG.Swing.MinAnchorHeightAbovePlayer and forwardAdvance > 8 and dist >= 22 then
					local distPenalty = math.abs(dist - CONFIG.Swing.IdealAnchorDistance) * 0.55
					local heightBonus = math.min(heightGain, 110) * 0.72
					local forwardBonus = math.min(forwardAdvance, 125) * 0.65
					local wallBonus = (math.abs(hit.Normal.Y) < 0.4) and 22 or 0
					local score = heightBonus + forwardBonus + wallBonus - distPenalty

					if score > bestScore then
						bestScore = score
						bestPos = hitPos
						bestNormal = hit.Normal
						isBuilding = true
					end
				end
			end
		end
	end

	-- 3. Free-Air Sky Anchor (Used when BuildingDetection is OFF, or as fallback when no buildings hit)
	if not bestPos and not previewOnly then
		if not SETTINGS.BuildingDetection or (not SETTINGS.StrictBuildingOnly and CONFIG.Swing.AllowFreeAirSwing) then
			local speedLead = clamp(flatVel.Magnitude * CONFIG.Swing.FreeAirSpeedLeadFactor, 0, 56)
			local forwardOffset = CONFIG.Swing.FreeAirBaseForwardOffset + speedLead
			bestPos = origin + (forwardDir * forwardOffset) + Vector3.new(0, CONFIG.Swing.FreeAirUpwardOffset, 0)
			bestNormal = -forwardDir
			isBuilding = false
		end
	end

	return bestPos, bestNormal, isBuilding
end

local function updateBuildingAnchorReticle()
	local bbg = PhysicsObjects.AnchorReticleGui
	local part = PhysicsObjects.AnchorReticlePart
	local ring = PhysicsObjects.AnchorReticleRing
	if not bbg or not part or not ring then return end

	if not SETTINGS.BuildingDetection or not SETTINGS.WebTargetReticle or State.IsSwinging or State.IsCrawling or State.IsHanging or State.IsGliding then
		bbg.Enabled = false
		return
	end

	local anchorPos, _, isBuilding = findBestSwingAnchor(true)
	if anchorPos and isBuilding then
		part.Position = anchorPos
		bbg.Enabled = true
		local pulse = 1 + math.sin(os.clock() * 8) * 0.14
		ring.Size = UDim2.new(pulse, 0, pulse, 0)
		ring.Position = UDim2.new(0.5 * (1 - pulse), 0, 0.5 * (1 - pulse), 0)
	else
		bbg.Enabled = false
	end
end

local function stopSwing(applyVault)
	if not State.IsSwinging then return end
	State.IsSwinging = false

	stopAnim("WebSwing", 0.2)

	if PhysicsObjects.SwingRope then
		PhysicsObjects.SwingRope.Enabled = false
	end
	if PhysicsObjects.SwingVectorForce then
		PhysicsObjects.SwingVectorForce.Enabled = false
		PhysicsObjects.SwingVectorForce.Force = Vector3.zero
	end
	if PhysicsObjects.SwingAlignOrientation then
		PhysicsObjects.SwingAlignOrientation.Enabled = false
	end
	if PhysicsObjects.SwingWebBeamMain then
		PhysicsObjects.SwingWebBeamMain:Destroy()
		PhysicsObjects.SwingWebBeamMain = nil
	end
	if PhysicsObjects.SpeedTrailRight then PhysicsObjects.SpeedTrailRight.Enabled = false end
	if PhysicsObjects.SpeedTrailLeft then PhysicsObjects.SpeedTrailLeft.Enabled = false end

	if RootPart and Humanoid then
		makeCharacterUpright()

		if applyVault then
			local vel = RootPart.AssemblyLinearVelocity
			local flatDir = safeUnit(Vector3.new(vel.X, 0, vel.Z), safeUnit(Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z), Vector3.new(0, 0, -1)))

			local releaseVel = vel * CONFIG.Swing.ReleaseMomentumMultiplier
				+ flatDir * CONFIG.Swing.ReleaseForwardImpulse
				+ Vector3.new(0, CONFIG.Swing.ReleaseUpwardImpulse, 0)

			local horiz = Vector3.new(releaseVel.X, 0, releaseVel.Z)
			if horiz.Magnitude > CONFIG.Swing.MaxTerminalSwingSpeed then
				horiz = horiz.Unit * CONFIG.Swing.MaxTerminalSwingSpeed
			end
			RootPart.AssemblyLinearVelocity = Vector3.new(horiz.X, math.min(releaseVel.Y, 74), horiz.Z)

			playWhooshSound(1.12)
			State.CanDoubleJump = true
			State.HasDoubleJumped = false
			State.AirZipCount = 0

			-- CHECK SETTING: Front Flipping While Swinging ON vs OFF
			if SETTINGS.SwingFrontFlip then
				performBodyFlip("Front")
			end
		end
	end
end

local function startSwing()
	if not RootPart or not Humanoid or Humanoid.Health <= 0 then return end
	if State.IsSwinging then return end

	stopBodyFlip()

	local anchorPos, anchorNormal, isBuilding = findBestSwingAnchor(false)
	if not anchorPos then return end

	State.IsSwinging = true
	State.SwingAnchorPos = anchorPos
	State.SwingStartTime = os.clock()
	State.IsBuildingAnchor = isBuilding
	State.CanDoubleJump = true
	State.HasDoubleJumped = false
	State.AirZipCount = 0

	State.ActiveHand = (State.ActiveHand == "Right") and "Left" or "Right"
	local wristAtt = (State.ActiveHand == "Right") and PhysicsObjects.RightWristAttachment or PhysicsObjects.LeftWristAttachment
	if not wristAtt then
		wristAtt = PhysicsObjects.RootAttachment
	end

	-- Ground-to-Swing Vault Impulse
	if isGrounded() then
		local camLook = safeUnit(Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z), Vector3.new(0, 0, -1))
		RootPart.AssemblyLinearVelocity = RootPart.AssemblyLinearVelocity
			+ Vector3.new(0, CONFIG.Swing.GroundVaultUpImpulse, 0)
			+ camLook * CONFIG.Swing.GroundVaultForwardImpulse
		Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end

	--Dive Momentum Conversion
	local currentVel = RootPart.AssemblyLinearVelocity
	local ropeVec = anchorPos - RootPart.Position
	local ropeDir = safeUnit(ropeVec, Vector3.yAxis)
	local initialDist = clamp(ropeVec.Magnitude, CONFIG.Swing.MinRopeLength, CONFIG.Swing.MaxRopeLength)

	if currentVel.Y < -18 then
		local fallSpeed = math.abs(currentVel.Y)
		local camFlat = safeUnit(Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z), Vector3.new(0, 0, -1))
		local tangent = safeUnit(camFlat - ropeDir * camFlat:Dot(ropeDir), camFlat)
		local convertedSpeed = math.min(currentVel.Magnitude + fallSpeed * 0.35 * CONFIG.Swing.DiveMomentumConversion, CONFIG.Swing.MaxTerminalSwingSpeed)
		RootPart.AssemblyLinearVelocity = tangent * convertedSpeed
		addCameraShake(0.32)
	end

	State.CurrentRopeLength = initialDist
	PhysicsObjects.SwingAnchorPart.Position = anchorPos

	PhysicsObjects.SwingRope.Attachment0 = PhysicsObjects.RootAttachment
	PhysicsObjects.SwingRope.Attachment1 = PhysicsObjects.SwingAnchorAttachment
	PhysicsObjects.SwingRope.Length = initialDist
	PhysicsObjects.SwingRope.Enabled = true

	PhysicsObjects.SwingVectorForce.Enabled = true
	PhysicsObjects.SwingAlignOrientation.Enabled = true
	Humanoid.AutoRotate = false

	if PhysicsObjects.SwingWebBeamMain then
		PhysicsObjects.SwingWebBeamMain:Destroy()
	end
	local mainBeam, coreBeam = createWebBeam(wristAtt, PhysicsObjects.SwingAnchorAttachment, 0.19, 0.11, CONFIG.Visuals.WebColor)
	PhysicsObjects.SwingWebBeamMain = mainBeam
	PhysicsObjects.SwingWebBeamCore = coreBeam

	if PhysicsObjects.SpeedTrailRight then PhysicsObjects.SpeedTrailRight.Enabled = true end
	if PhysicsObjects.SpeedTrailLeft then PhysicsObjects.SpeedTrailLeft.Enabled = true end

	spawnWebNozzleFlash(wristAtt)
	spawnAnchorWebSplat(anchorPos, anchorNormal, isBuilding)
	playWebSound(1.0)
	playAnim("WebSwing", 0.15, 1.0)
end

local function updateSwingPhysics(dt)
	if not State.IsSwinging or not RootPart or not Humanoid then return end

	local pos = RootPart.Position
	local vel = RootPart.AssemblyLinearVelocity
	local toAnchor = State.SwingAnchorPos - pos
	local distToAnchor = toAnchor.Magnitude
	local ropeDir = safeUnit(toAnchor, Vector3.yAxis)

	-- Dynamic Web Tension Curve (slight elastic sag on fire -> taut wire)
	if PhysicsObjects.SwingWebBeamMain and PhysicsObjects.SwingWebBeamCore then
		local elapsed = os.clock() - State.SwingStartTime
		local sag = math.max(0, (1 - elapsed * 5.5)) * 2.2
		PhysicsObjects.SwingWebBeamMain.CurveSize0 = sag
		PhysicsObjects.SwingWebBeamCore.CurveSize0 = sag + 0.25
	end

	-- Ground Clearance Protection & Ground-Skim Wake VFX
	local groundRay = Workspace:Raycast(pos, Vector3.new(0, -18, 0), getRayParams())
	if groundRay then
		local groundDist = (pos - groundRay.Position).Magnitude
		if groundDist < CONFIG.Swing.GroundClearanceBuffer and State.CurrentRopeLength > CONFIG.Swing.MinRopeLength then
			State.CurrentRopeLength = math.max(CONFIG.Swing.MinRopeLength, State.CurrentRopeLength - CONFIG.Swing.ReelSpeed * 1.45 * dt)
		end
		if groundDist < CONFIG.Swing.GroundSkimHeight and vel.Magnitude > 45 then
			spawnGroundSkimWake(groundRay.Position, groundRay.Normal, vel)
		end
	end

	-- Active Rope Winch (Hold Space to reel in, Hold Ctrl to extend)
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		State.CurrentRopeLength = math.max(CONFIG.Swing.MinRopeLength, State.CurrentRopeLength - CONFIG.Swing.ReelSpeed * dt)
	elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		State.CurrentRopeLength = math.min(CONFIG.Swing.MaxRopeLength, State.CurrentRopeLength + CONFIG.Swing.ReelSpeed * dt)
	end
	PhysicsObjects.SwingRope.Length = State.CurrentRopeLength

	-- Pendulum Tangent & Steering Vectors
	local camCF = Camera.CFrame
	local camFlatLook = safeUnit(Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z), Vector3.new(0, 0, -1))
	local moveInput = getWorldMoveDirection()
	local desiredFlatDir = (moveInput.Magnitude > 0.05) and moveInput or camFlatLook

	local velFlat = Vector3.new(vel.X, 0, vel.Z)
	local currentForward = (velFlat.Magnitude > 5) and velFlat.Unit or desiredFlatDir
	local tangentDir = safeUnit(currentForward - ropeDir * currentForward:Dot(ropeDir), desiredFlatDir)
	local steerTangent = safeUnit(desiredFlatDir - ropeDir * desiredFlatDir:Dot(ropeDir), tangentDir)

	local mass = getCharacterMass()
	local surgeMult = State.IsSurgeActive and CONFIG.Ultimates.SurgeSpeedMultiplier or 1.0
	local totalForce = Vector3.zero

	-- 1. Downswing Gravity Acceleration
	if vel.Y < 0 then
		local downGravity = Workspace.Gravity * (CONFIG.Swing.GravityMultiplierDownswing - 1) * mass
		totalForce = totalForce + Vector3.new(0, -downGravity, 0)
	end

	-- 2. Tangential Pendulum Drive
	totalForce = totalForce + tangentDir * (CONFIG.Swing.TangentialDriveForce * surgeMult)

	-- 3. Bottom-of-Arc Whip Boost
	local verticalAlignment = ropeDir:Dot(Vector3.yAxis)
	if verticalAlignment > 0.80 and distToAnchor >= State.CurrentRopeLength * 0.88 then
		local whipFactor = clamp((verticalAlignment - 0.80) / 0.20, 0, 1)
		totalForce = totalForce + tangentDir * (CONFIG.Swing.BottomArcWhipBoost * whipFactor * surgeMult)
	end

	-- 4. Upswing Momentum Assist
	if vel.Y > 0 and pos.Y < State.SwingAnchorPos.Y - 8 then
		totalForce = totalForce + tangentDir * CONFIG.Swing.UpswingMomentumAssist
	end

	-- 5. Omnidirectional Steering & Carve
	if moveInput.Magnitude > 0.05 then
		totalForce = totalForce + steerTangent * CONFIG.Swing.OmnidirectionalSteerForce
		local speed = vel.Magnitude
		if speed > 14 then
			local carvedDir = safeUnit(vel.Unit:Lerp(steerTangent, clamp(CONFIG.Swing.VelocityCarveTurnRate * dt, 0, 0.28)), vel.Unit)
			RootPart.AssemblyLinearVelocity = carvedDir * speed
		end
	end

	-- 6. Quadratic Aerodynamic Drag + Speed Cap
	local speed = vel.Magnitude
	local maxSpeed = CONFIG.Swing.MaxTerminalSwingSpeed * surgeMult
	local dragMag = speed * speed * CONFIG.Swing.AirResistanceCoeff
	if speed > 1 then
		totalForce = totalForce - vel.Unit * dragMag
	end
	if speed > maxSpeed then
		RootPart.AssemblyLinearVelocity = vel.Unit * maxSpeed
	end

	PhysicsObjects.SwingVectorForce.Force = totalForce

	-- Smooth Pendulum Body Banking Orientation
	local lookDir = (vel.Magnitude > 6) and vel.Unit or tangentDir
	local upVec = safeUnit(ropeDir:Lerp(Vector3.yAxis, 0.35), Vector3.yAxis)
	local rightVec = safeUnit(lookDir:Cross(upVec), Vector3.xAxis)
	local correctedUp = safeUnit(rightVec:Cross(lookDir), Vector3.yAxis)
	PhysicsObjects.SwingAlignOrientation.CFrame = CFrame.fromMatrix(pos, rightVec, correctedUp, -lookDir)

	-- Auto-Release at High Apex
	if pos.Y > State.SwingAnchorPos.Y - 4 and vel.Y > 8 and (os.clock() - State.SwingStartTime) > 0.42 then
		stopSwing(true)
	end
end

