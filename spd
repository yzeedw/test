local function stopWebHang()
	if not State.IsHanging then return end
	State.IsHanging = false

	stopAnim("WebHang", 0.2)

	if PhysicsObjects.HangRope then
		PhysicsObjects.HangRope.Enabled = false
	end
	if PhysicsObjects.HangVectorForce then
		PhysicsObjects.HangVectorForce.Enabled = false
		PhysicsObjects.HangVectorForce.Force = Vector3.zero
	end
	if PhysicsObjects.HangLinearVelocity then
		PhysicsObjects.HangLinearVelocity.Enabled = false
		PhysicsObjects.HangLinearVelocity.VectorVelocity = Vector3.zero
	end
	if PhysicsObjects.HangAlignOrientation then
		PhysicsObjects.HangAlignOrientation.Enabled = false
	end
	if PhysicsObjects.HangBeam then
		PhysicsObjects.HangBeam:Destroy()
		PhysicsObjects.HangBeam = nil
	end
	if PhysicsObjects.HangWristBeam then
		PhysicsObjects.HangWristBeam:Destroy()
		PhysicsObjects.HangWristBeam = nil
	end

	makeCharacterUpright()
end

local function toggleWebHang()
	if State.IsHanging then
		stopWebHang()
		return
	end
	if not RootPart or not Humanoid then return end

	stopSwing(false)
	stopCrawl()
	stopBodyFlip()

	local origin = RootPart.Position
	local params = getRayParams()
	local ceilHit = Workspace:Raycast(origin, Vector3.new(0, CONFIG.WebHang.MaxCeilingDistance, 0), params)

	if not ceilHit then
		for i = 1, 12 do
			local angle = (i / 12) * math.pi * 2
			local dir = (Vector3.new(math.cos(angle) * 0.28, 1, math.sin(angle) * 0.28)).Unit
			local hit = Workspace:Raycast(origin, dir * CONFIG.WebHang.MaxCeilingDistance, params)
			if hit and (hit.Position.Y - origin.Y) > 16 then
				ceilHit = hit
				break
			end
		end
	end

	local anchorPos
	local anchorNormal = -Vector3.yAxis
	local isBuilding = false
	if ceilHit and (ceilHit.Position.Y - origin.Y) > 14 then
		anchorPos = ceilHit.Position
		anchorNormal = ceilHit.Normal
		isBuilding = true
	else
		anchorPos = origin + Vector3.new(0, CONFIG.WebHang.DefaultSkyCeilingHeight, 0)
	end

	State.IsHanging = true
	State.HangAnchorPos = anchorPos
	local currentDist = (anchorPos - origin).Magnitude

	local floorRay = Workspace:Raycast(origin, Vector3.new(0, -25, 0), params)
	local groundClearance = floorRay and (origin.Y - floorRay.Position.Y) or 999
	if groundClearance < CONFIG.WebHang.MinGroundClearanceWhenHanging then
		local liftNeeded = CONFIG.WebHang.MinGroundClearanceWhenHanging - groundClearance
		State.HangLength = clamp(currentDist - liftNeeded, CONFIG.WebHang.MinHangLength, CONFIG.WebHang.MaxHangLength)
	else
		State.HangLength = clamp(currentDist, CONFIG.WebHang.MinHangLength, CONFIG.WebHang.MaxHangLength)
	end

	Humanoid.PlatformStand = false
	Humanoid.AutoRotate = false

	PhysicsObjects.HangAnchorPart.Position = anchorPos
	PhysicsObjects.HangRope.Attachment0 = PhysicsObjects.TopHangAttachment
	PhysicsObjects.HangRope.Attachment1 = PhysicsObjects.HangAnchorAttachment
	PhysicsObjects.HangRope.Length = State.HangLength
	PhysicsObjects.HangRope.Enabled = true

	PhysicsObjects.HangVectorForce.Enabled = true
	PhysicsObjects.HangAlignOrientation.Enabled = true

	local mainBeam = createWebBeam(PhysicsObjects.TopHangAttachment, PhysicsObjects.HangAnchorAttachment, 0.16, 0.12, CONFIG.Visuals.WebColor)
	PhysicsObjects.HangBeam = mainBeam

	if PhysicsObjects.RightWristAttachment then
		local wristBeam = createWebBeam(PhysicsObjects.RightWristAttachment, PhysicsObjects.TopHangAttachment, 0.11, 0.11, CONFIG.Visuals.WebColor)
		PhysicsObjects.HangWristBeam = wristBeam
	end

	spawnAnchorWebSplat(anchorPos, anchorNormal, isBuilding)
	playWebSound(0.95)
	playAnim("WebHang", 0.2, 1.0)
end

local function updateWebHangPhysics(dt)
	if not State.IsHanging or not RootPart or not Humanoid then return end

	local pos = RootPart.Position
	local vel = RootPart.AssemblyLinearVelocity
	local toAnchor = State.HangAnchorPos - pos
	local currentDist = toAnchor.Magnitude
	local ropeDir = safeUnit(toAnchor, Vector3.yAxis)

	local forwardAxis, rightAxis = getRawInputAxes()
	local isClimbingUp = (forwardAxis > 0.1) or UserInputService:IsKeyDown(Enum.KeyCode.Space)
	local isRappellingDown = (forwardAxis < -0.1) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)

	if isClimbingUp then
		State.HangLength = math.max(CONFIG.WebHang.MinHangLength, State.HangLength - CONFIG.WebHang.ClimbSpeed * dt)
	elseif isRappellingDown then
		State.HangLength = math.min(CONFIG.WebHang.MaxHangLength, State.HangLength + CONFIG.WebHang.ClimbSpeed * dt)
	end

	PhysicsObjects.HangRope.Length = State.HangLength

	local camCF = Camera.CFrame
	local camRight = safeUnit(Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z), Vector3.xAxis)
	local camLook = safeUnit(Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z), Vector3.new(0, 0, -1))

	local needWinchUp = (currentDist > State.HangLength + 0.6) or isClimbingUp
	if needWinchUp and State.HangLength > CONFIG.WebHang.MinHangLength then
		local pullSpeed = isClimbingUp and CONFIG.WebHang.ClimbSpeed or CONFIG.WebHang.AutoLiftSpeed
		local lateralVel = vel - ropeDir * vel:Dot(ropeDir)
		PhysicsObjects.HangLinearVelocity.VectorVelocity = (ropeDir * pullSpeed) + (lateralVel * 0.85) + (camRight * rightAxis * 14)
		PhysicsObjects.HangLinearVelocity.Enabled = true
	else
		PhysicsObjects.HangLinearVelocity.Enabled = false
	end

	local swayInputVec = camRight * rightAxis
	local swayForce = swayInputVec * CONFIG.WebHang.SwayForce
	local horizVel = Vector3.new(vel.X, 0, vel.Z)
	local dampingForce = -horizVel * (getCharacterMass() * CONFIG.WebHang.HorizontalDamping)
	PhysicsObjects.HangVectorForce.Force = swayForce + dampingForce

	local upVec = ropeDir
	local rightVec = safeUnit(camLook:Cross(upVec), camRight)
	local correctedLook = safeUnit(upVec:Cross(rightVec), camLook)
	PhysicsObjects.HangAlignOrientation.CFrame = CFrame.fromMatrix(pos, rightVec, upVec, -correctedLook)
end

