local function startJumpCharge()
	if not RootPart or not Humanoid then return end

	if State.PointLaunchReady and (os.clock() <= State.PointLaunchExpire) then
		State.PointLaunchReady = false
		local look = safeUnit(Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z), Vector3.new(0, 0, -1))
		RootPart.AssemblyLinearVelocity = look * CONFIG.WebZip.PointLaunchForward + Vector3.new(0, CONFIG.WebZip.PointLaunchUp, 0)
		spawnShockwaveRing(RootPart.Position, Vector3.yAxis, 2, 18, 0.35, CONFIG.Visuals.WebGlowColor)
		playWhooshSound(1.25)
		performBodyFlip("Front")
		return
	end

	if State.IsCrawling then
		local jumpNormal = State.CrawlNormal
		stopCrawl()
		RootPart.AssemblyLinearVelocity = jumpNormal * CONFIG.Crawl.WallJumpAway + Vector3.new(0, CONFIG.Crawl.WallJumpUp, 0)
		playWhooshSound(1.15)
		performBodyFlip("Back")
		return
	end

	if State.IsHanging then
		stopWebHang()
		RootPart.AssemblyLinearVelocity = Vector3.new(0, 46, 0) + Camera.CFrame.LookVector * 26
		performBodyFlip("Front")
		return
	end

	if not isGrounded() and not State.IsSwinging and State.CanDoubleJump and not State.HasDoubleJumped then
		State.HasDoubleJumped = true
		local moveDir = getWorldMoveDirection()
		if moveDir.Magnitude < 0.05 then
			moveDir = safeUnit(Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z), Vector3.new(0, 0, -1))
		end
		RootPart.AssemblyLinearVelocity = Vector3.new(RootPart.AssemblyLinearVelocity.X * 0.5, 0, RootPart.AssemblyLinearVelocity.Z * 0.5)
			+ moveDir * CONFIG.Jump.DoubleJumpForward
			+ Vector3.new(0, CONFIG.Jump.DoubleJumpUp, 0)
		spawnShockwaveRing(RootPart.Position - Vector3.new(0, 2, 0), Vector3.yAxis, 1.5, 11, 0.30, CONFIG.Visuals.WebGlowColor)
		playSwooshSound(1.2)
		performBodyFlip("Front")
		return
	end

	if isGrounded() then
		State.IsChargingJump = true
		State.JumpChargeStart = os.clock()
	end
end

local function releaseJumpCharge()
	if not State.IsChargingJump then return end
	State.IsChargingJump = false

	if not RootPart or not Humanoid or not isGrounded() then return end
	local chargeTime = os.clock() - State.JumpChargeStart
	local alpha = clamp(chargeTime / CONFIG.Jump.MaxChargeTime, 0, 1)

	if alpha > 0.22 then
		local jumpPower = lerp(CONFIG.Jump.BaseJumpPower, CONFIG.Jump.MaxChargedJumpPower, alpha)
		local forwardBoost = safeUnit(Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z), Vector3.new(0, 0, -1)) * (26 * alpha)
		Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		RootPart.AssemblyLinearVelocity = Vector3.new(RootPart.AssemblyLinearVelocity.X, jumpPower, RootPart.AssemblyLinearVelocity.Z) + forwardBoost
		spawnShockwaveRing(RootPart.Position - Vector3.new(0, 2.5, 0), Vector3.yAxis, 2, 18 * alpha + 6, 0.38, CONFIG.Visuals.WebGlowColor)
		playWhooshSound(0.95)
		addCameraShake(0.42 * alpha)
		State.CanDoubleJump = true
		State.HasDoubleJumped = false
		State.AirZipCount = 0
		if alpha > 0.5 then
			performBodyFlip("Front")
		end
	end
end

