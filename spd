local function releaseSlingshot()
	if not State.IsChargingSling then return end
	State.IsChargingSling = false

	local chargeAlpha = clamp((os.clock() - State.SlingChargeStart) / CONFIG.Slingshot.MaxChargeTime, 0, 1)
	cleanupSlingshotVisuals()

	if not RootPart or not Humanoid then return end
	local launchSpeed = lerp(CONFIG.Slingshot.MinLaunchSpeed, CONFIG.Slingshot.MaxLaunchSpeed, chargeAlpha)
	local launchDir = safeUnit(Camera.CFrame.LookVector + Vector3.new(0, 0.25, 0), Vector3.new(0, 0.3, -1))

	Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	RootPart.AssemblyLinearVelocity = launchDir * launchSpeed + Vector3.new(0, CONFIG.Slingshot.UpwardLift * chargeAlpha, 0)

	spawnShockwaveRing(RootPart.Position, launchDir, 3, 22, 0.42, CONFIG.Visuals.WebGlowColor)
	playWhooshSound(0.92)
	addCameraShake(0.65)
	State.CanDoubleJump = true
	State.HasDoubleJumped = false
