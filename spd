local function fireWebProjectile()
	if not RootPart then return end
	if not consumeFluid(CONFIG.Gadgets.WebShotCost) then return end

	State.ActiveHand = (State.ActiveHand == "Right") and "Left" or "Right"
	local wristAtt = (State.ActiveHand == "Right") and PhysicsObjects.RightWristAttachment or PhysicsObjects.LeftWristAttachment
	local startPos = wristAtt and wristAtt.WorldPosition or (RootPart.Position + RootPart.CFrame.LookVector * 2)
	local aimDir = Camera.CFrame.LookVector

	spawnWebNozzleFlash(wristAtt)
	playWebSound(1.25)

	local proj = Instance.new("Part")
	proj.Name = "WebProjectile"
	proj.Size = Vector3.new(0.6, 0.6, 1.8)
	proj.Material = Enum.Material.Neon
	proj.Color = CONFIG.Visuals.WebColor
	proj.Anchored = true
	proj.CanCollide = false
	proj.CanQuery = false
	proj.CanTouch = false
	proj.CFrame = CFrame.lookAt(startPos, startPos + aimDir)
	proj.Parent = ensureVFXFolder()

	local att0 = Instance.new("Attachment", proj)
	att0.Position = Vector3.new(0, 0, -0.7)
	local att1 = Instance.new("Attachment", proj)
	att1.Position = Vector3.new(0, 0, 0.7)

