local function throwWebBomb()
	if not RootPart then return end
	if not consumeFluid(CONFIG.Gadgets.WebBombCost) then return end

	playWebSound(0.85)
	local startPos = RootPart.Position + RootPart.CFrame.LookVector * 3 + Vector3.new(0, 2, 0)
	local vel = Camera.CFrame.LookVector * 105 + Vector3.new(0, 28, 0)

	local bomb = Instance.new("Part")
