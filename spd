local function spawnLightningArc(p0, p1, color, thickness, duration)
	local dist = (p1 - p0).Magnitude
	local segments = math.clamp(math.floor(dist / 3.5), 3, 12)
	local prev = p0
	local dir = safeUnit(p1 - p0, Vector3.yAxis)

	for i = 1, segments do
		local alpha = i / segments
		local nextPos = p0:Lerp(p1, alpha)
		if i < segments then
			local jitter = Vector3.new(
				(math.random() - 0.5) * 2.4,
				(math.random() - 0.5) * 2.4,
				(math.random() - 0.5) * 2.4
			)
			jitter = jitter - dir * jitter:Dot(dir)
			nextPos = nextPos + jitter
		end

		local segLen = (nextPos - prev).Magnitude
		local bolt = Instance.new("Part")
		bolt.Name = "BioArc"
		bolt.Size = Vector3.new(thickness or 0.22, thickness or 0.22, segLen)
		bolt.Material = Enum.Material.Neon
		bolt.Color = color or CONFIG.Visuals.VenomColor
		bolt.Anchored = true
		bolt.CanCollide = false
		bolt.CanQuery = false
		bolt.CanTouch = false
		bolt.CFrame = CFrame.lookAt((prev + nextPos) * 0.5, nextPos)
		bolt.Parent = ensureVFXFolder()

		TweenService:Create(bolt, TweenInfo.new(duration or 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Transparency = 1,
			Size = Vector3.new(0.02, 0.02, segLen),
		}):Play()
		Debris:AddItem(bolt, (duration or 0.22) + 0.04)

		prev = nextPos
	end
end

