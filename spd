RunService.Heartbeat:Connect(function(dt)
	if not Character or not RootPart or not Humanoid or Humanoid.Health <= 0 then return end

	State.LastVerticalSpeed = RootPart.AssemblyLinearVelocity.Y

	if State.IsShielding then
		State.WebFluid = math.max(0, State.WebFluid - CONFIG.Gadgets.WebShieldCostPerSec * dt)
		if State.WebFluid <= 0 then
			toggleWebShield(false)
		end
	else
		local regen = CONFIG.Gadgets.FluidRegenRate * (State.IsSurgeActive and 4.0 or 1.0)
		State.WebFluid = math.min(CONFIG.Gadgets.MaxWebFluid, State.WebFluid + regen * dt)
	end

	if State.IsSwinging then
		updateSwingPhysics(dt)
	elseif State.IsCrawling then
		updateCrawlPhysics(dt)
	elseif State.IsHanging then
		updateWebHangPhysics(dt)
	elseif State.IsGliding then
		updateWebWingsPhysics(dt)
	end

	scanSpiderSense()
	updateBuildingAnchorReticle()

	if Sounds.AirWind then
		local speed = RootPart.AssemblyLinearVelocity.Magnitude
		local targetVol = clamp((speed - 38) / 85, 0, 0.72)
		Sounds.AirWind.Volume = lerp(Sounds.AirWind.Volume, targetVol, clamp(dt * 8, 0, 1))
		Sounds.AirWind.PlaybackSpeed = lerp(0.85, 1.35, clamp(speed / 120, 0, 1))
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if not Character or not RootPart or not Camera then return end

	local vel = RootPart.AssemblyLinearVelocity
	local speed = vel.Magnitude

	if SETTINGS.DynamicCameraFX then
		local targetFOV = clamp(CONFIG.Camera.BaseFOV + (speed / 104) * (CONFIG.Camera.MaxFOV - CONFIG.Camera.BaseFOV), CONFIG.Camera.BaseFOV, CONFIG.Camera.MaxFOV)
		Camera.FieldOfView = lerp(Camera.FieldOfView, targetFOV, clamp(dt * CONFIG.Camera.FOVLerpSpeed, 0, 1))

		local targetRoll = 0
		if State.IsSwinging or State.IsGliding then
			local lateralSpeed = vel:Dot(Camera.CFrame.RightVector)
			targetRoll = clamp(-lateralSpeed * 0.14, -CONFIG.Camera.MaxRollAngle, CONFIG.Camera.MaxRollAngle)
		end
		State.CurrentRoll = lerp(State.CurrentRoll, targetRoll, clamp(dt * CONFIG.Camera.RollLerpSpeed, 0, 1))
		if math.abs(State.CurrentRoll) > 0.05 then
			Camera.CFrame = Camera.CFrame * CFrame.Angles(0, 0, math.rad(State.CurrentRoll))
		end

		if State.ShakeIntensity > 0.01 then
			local rx = (math.random() - 0.5) * 2 * State.ShakeIntensity
			local ry = (math.random() - 0.5) * 2 * State.ShakeIntensity
			Camera.CFrame = Camera.CFrame * CFrame.new(rx, ry, 0)
			State.ShakeIntensity = math.max(0, State.ShakeIntensity - dt * 3.2)
		end
	else
		Camera.FieldOfView = lerp(Camera.FieldOfView, CONFIG.Camera.BaseFOV, clamp(dt * 10, 0, 1))
		State.CurrentRoll = 0
		State.ShakeIntensity = 0
	end

	updateHUDVisuals(dt)
end)

