local function scanSpiderSense()
	if not RootPart then return end
	if not SETTINGS.AutoSpiderSense then
		State.DangerDetected = false
		if UI.SpiderSenseGui then UI.SpiderSenseGui.Enabled = false end
		return
	end

	local origin = RootPart.Position
	local overlap = Workspace:GetPartBoundsInRadius(origin, CONFIG.SpiderSense.ScanRadius)
	local dangerFound = false
	local closestThreat = nil
	local minTime = math.huge

	for _, part in ipairs(overlap) do
		if not part:IsDescendantOf(Character) and not part.Anchored then
			local v = part.AssemblyLinearVelocity
			local speed = v.Magnitude
			if speed >= CONFIG.SpiderSense.ProjectileSpeedThresh then
				local toPlayer = origin - part.Position
				local approach = v.Unit:Dot(safeUnit(toPlayer, Vector3.yAxis))
				if approach > 0.72 then
					local eta = toPlayer.Magnitude / speed
					if eta < minTime and eta < 1.4 then
						minTime = eta
						dangerFound = true
						closestThreat = part
					end
				end
			end
		end
	end

	State.DangerDetected = dangerFound
	State.ThreatPart = closestThreat
	State.ThreatPosition = closestThreat and closestThreat.Position or nil

	if UI.SpiderSenseGui then
		UI.SpiderSenseGui.Enabled = dangerFound
	end
end

local function performSpiderSenseDodge()
	if not RootPart or not Humanoid then return end
	if not isCooldownReady("Dodge") or State.IsDodging then return end

	setCooldown("Dodge", CONFIG.SpiderSense.DodgeCooldown)
	stopSwing(false)
	stopCrawl()
	stopWebHang()

	State.IsDodging = true
	playSwooshSound(1.22)

	local moveInput = getWorldMoveDirection()
	local dodgeDir = (moveInput.Magnitude > 0.05) and moveInput or (- safeUnit(Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z), Vector3.new(0, 0, 1)))

	if State.DangerDetected and State.ThreatPart and State.ThreatPart.Parent then
		local threatPos = State.ThreatPart.Position
		spawnShockwaveRing(RootPart.Position, Vector3.yAxis, 2, 18, 0.35, CONFIG.Visuals.SenseColor)

		local wristAtt = PhysicsObjects.RightWristAttachment or PhysicsObjects.RootAttachment
		local tempAtt = Instance.new("Attachment", State.ThreatPart)
		local counterBeam = createWebBeam(wristAtt, tempAtt, 0.18, 0.12, CONFIG.Visuals.WebColor)
		playWebSound(1.3)
		wrapTargetInWebCocoon(State.ThreatPart)
		State.ThreatPart.AssemblyLinearVelocity = -State.ThreatPart.AssemblyLinearVelocity * 0.85
		Debris:AddItem(counterBeam, 0.25)
		Debris:AddItem(tempAtt, 0.25)
	end

	local camRight = Camera.CFrame.RightVector
	local sideDot = dodgeDir:Dot(camRight)
	if sideDot > 0.45 then
		performBodyFlip("SideRight")
	elseif sideDot < -0.45 then
		performBodyFlip("SideLeft")
	elseif dodgeDir:Dot(Camera.CFrame.LookVector) < -0.25 then
		performBodyFlip("Back")
	else
		performBodyFlip("Front")
	end

	local startTime = os.clock()
	task.spawn(function()
		while (os.clock() - startTime) < CONFIG.SpiderSense.DodgeDuration do
			if not RootPart or State.IsSwinging or State.IsCrawling then break end
			RootPart.AssemblyLinearVelocity = dodgeDir * CONFIG.SpiderSense.DodgeSpeed + Vector3.new(0, 14, 0)
			RunService.Heartbeat:Wait()
		end
		State.IsDodging = false
	end)
end

