local function loadCharacterAnimations()
	if not Humanoid then return end
	Animator = Humanoid:FindFirstChildOfClass("Animator")
	if not Animator then
		Animator = Instance.new("Animator")
		Animator.Parent = Humanoid
	end

	local function loadTrack(animId, priority, looped)
		if not animId or animId == "" then return nil end
		local anim = Instance.new("Animation")
		anim.AnimationId = animId
		local ok, track = pcall(function()
			return Animator:LoadAnimation(anim)
		end)
		if ok and track then
			track.Priority = priority
			track.Looped = looped
			return track
		end
		return nil
	end

	AnimTracks.WebSwing  = loadTrack(CONFIG.Animations.WebSwing, Enum.AnimationPriority.Action3, true)
	AnimTracks.WallCrawl = loadTrack(CONFIG.Animations.WallCrawl, Enum.AnimationPriority.Movement, true)
	AnimTracks.WebHang   = loadTrack(CONFIG.Animations.WebHang, Enum.AnimationPriority.Action2, true)
	AnimTracks.Flip      = loadTrack(CONFIG.Animations.Flip, Enum.AnimationPriority.Action4, false)
	AnimTracks.Landing   = loadTrack(CONFIG.Animations.Landing, Enum.AnimationPriority.Action4, false)
	AnimTracks.WebZip    = loadTrack(CONFIG.Animations.WebZip, Enum.AnimationPriority.Action4, false)
end

local function playAnim(name, fadeTime, speed)
	local track = AnimTracks[name]
	if track then
		if not track.IsPlaying then
			track:Play(fadeTime or 0.15, 1, speed or 1.0)
		else
			track:AdjustSpeed(speed or 1.0)
		end
	end
end

local function stopAnim(name, fadeTime)
	local track = AnimTracks[name]
	if track and track.IsPlaying then
		track:Stop(fadeTime or 0.2)
	end
end

local function playLandingAnimation()
	local track = AnimTracks.Landing
	if not track then return end
	stopAnim("WebSwing", 0.08)
	stopAnim("Flip", 0.08)
	stopAnim("WebHang", 0.08)
	stopAnim("WebZip", 0.08)
	track:Play(0.05, 1, 1.05)

	task.delay(0.65, function()
