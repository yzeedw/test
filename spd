-- SYSTEM 4: WEB ZIP & POINT LAUNCH (USES WEB_ZIP_ANIM = "rbxassetid://100103306715371")
------------------------------------------------------------------------------------------------
local function performWebZip()
	if not RootPart or not Humanoid then return end
	if not isCooldownReady("WebZip") then return end
	if not isGrounded() and State.AirZipCount >= CONFIG.WebZip.MaxAirChainZips then return end

	setCooldown("WebZip", CONFIG.WebZip.Cooldown)
	stopSwing(false)
	stopCrawl()
	stopWebHang()
	stopBodyFlip()

	State.IsWebZipping = true
	if not isGrounded() then
		State.AirZipCount = State.AirZipCount + 1
	else
		State.AirZipCount = 0
	end

	local origin = RootPart.Position
	local camLook = Camera.CFrame.LookVector
	local params = getRayParams()
	local hit = Workspace:Raycast(origin, camLook * CONFIG.WebZip.MaxDistance, params)

	local targetPos
	local isSurfaceZip = false
	if hit then
		targetPos = hit.Position + hit.Normal * 3.2
		isSurfaceZip = true
		spawnAnchorWebSplat(hit.Position, hit.Normal, true)
	else
		local zipDir = Vector3.new(camLook.X, math.max(camLook.Y, 0.20), camLook.Z).Unit
		targetPos = origin + zipDir * CONFIG.WebZip.AirZipDistance
	end

	State.ActiveHand = (State.ActiveHand == "Right") and "Left" or "Right"
	local wristAtt = (State.ActiveHand == "Right") and PhysicsObjects.RightWristAttachment or PhysicsObjects.LeftWristAttachment
	if not wristAtt then wristAtt = PhysicsObjects.RootAttachment end

	local tempAnchor = Instance.new("Part")
	tempAnchor.Size = Vector3.new(0.2, 0.2, 0.2)
	tempAnchor.Position = hit and hit.Position or targetPos
	tempAnchor.Anchored = true
	tempAnchor.CanCollide = false
	tempAnchor.Transparency = 1
	tempAnchor.Parent = ensureVFXFolder()

	local tempAtt = Instance.new("Attachment")
	tempAtt.Parent = tempAnchor

	local zipBeam = createWebBeam(wristAtt, tempAtt, 0.21, 0.13, CONFIG.Visuals.WebColor)
	spawnWebNozzleFlash(wristAtt)
	spawnShockwaveRing(origin, (targetPos - origin).Unit, 2, 11, 0.28, CONFIG.Visuals.WebGlowColor)
	playWebSound(1.18)
	playWhooshSound(1.22)

	-- PLAY CUSTOM WEB ZIP ANIMATION (rbxassetid://100103306715371)
	playAnim("WebZip", 0.05, 1.15)

	local startTime = os.clock()
	local maxDuration = 0.56

	task.spawn(function()
		while State.IsWebZipping and (os.clock() - startTime) < maxDuration do
			if not RootPart or not RootPart.Parent or State.IsSwinging or State.IsCrawling then
				break
			end
			local toTarget = targetPos - RootPart.Position
			local dist = toTarget.Magnitude
			if dist <= CONFIG.WebZip.ArrivalThreshold then
				break
			end

			local zipDir = toTarget.Unit
			RootPart.AssemblyLinearVelocity = zipDir * CONFIG.WebZip.ZipSpeed
			local flatLook = safeUnit(Vector3.new(zipDir.X, 0, zipDir.Z), Vector3.new(0, 0, -1))
			RootPart.CFrame = CFrame.lookAt(RootPart.Position, RootPart.Position + flatLook)

			RunService.Heartbeat:Wait()
		end

		if zipBeam then zipBeam:Destroy() end
		if tempAnchor then tempAnchor:Destroy() end
		State.IsWebZipping = false
		stopAnim("WebZip", 0.16)

		if RootPart and not State.IsSwinging and not State.IsCrawling then
			makeCharacterUpright()
			if isSurfaceZip then
				State.PointLaunchReady = true
				State.PointLaunchExpire = os.clock() + CONFIG.WebZip.PointLaunchWindow
				RootPart.AssemblyLinearVelocity = RootPart.AssemblyLinearVelocity * 0.35 + Vector3.new(0, 20, 0)
			else
				RootPart.AssemblyLinearVelocity = RootPart.AssemblyLinearVelocity * 0.65 + Vector3.new(0, 18, 0)
			end
			State.CanDoubleJump = true
			State.HasDoubleJumped = false
		end
	end)
end

