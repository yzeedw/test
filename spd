------------------------------------------------------------------------------------------------
-- UTILITY & UNIVERSAL INPUT HELPERS
------------------------------------------------------------------------------------------------
local function clamp(val, minVal, maxVal)
	return math.max(minVal, math.min(maxVal, val))
end

local function lerp(a, b, t)
	return a + (b - a) * clamp(t, 0, 1)
end

local function safeUnit(v, fallback)
	if v.Magnitude > 1e-4 then
		return v.Unit
	end
	return fallback or Vector3.new(0, 0, -1)
end

local function getRayParams(extraIgnore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list = { Character, VFXFolder }
	if extraIgnore then
		for _, item in ipairs(extraIgnore) do
			table.insert(list, item)
		end
	end
	params.FilterDescendantsInstances = list
	params.IgnoreWater = true
	return params
end

local function isCooldownReady(name)
	return (os.clock() - (Cooldowns[name] or 0)) >= 0
end

local function setCooldown(name, duration)
	Cooldowns[name] = os.clock() + duration
end

local function consumeFluid(amount)
	if State.IsSurgeActive then
		return true
	end
	if State.WebFluid >= amount then
		State.WebFluid = math.max(0, State.WebFluid - amount)
		return true
	end
	return false
end

local function getRawInputAxes()
	local forward = 0
	local right = 0

	if not UserInputService:GetFocusedTextBox() then
		if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
			forward = forward + 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
			forward = forward - 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
			right = right + 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
			right = right - 1
		end
	end

	if math.abs(forward) < 0.05 and math.abs(right) < 0.05 and Humanoid and Camera then
		local moveDir = Humanoid.MoveDirection
		if moveDir.Magnitude > 0.05 then
			local camLook = safeUnit(Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z), Vector3.new(0, 0, -1))
			local camRight = safeUnit(Vector3.new(Camera.CFrame.RightVector.X, 0, Camera.CFrame.RightVector.Z), Vector3.xAxis)
			forward = clamp(moveDir:Dot(camLook), -1, 1)
			right = clamp(moveDir:Dot(camRight), -1, 1)
		end
	end

	return forward, right
end

local function getWorldMoveDirection()
	if Humanoid and Humanoid.MoveDirection.Magnitude > 0.05 then
		return Humanoid.MoveDirection.Unit
	end
	local forward, right = getRawInputAxes()
	if math.abs(forward) > 0.05 or math.abs(right) > 0.05 then
		local camCF = Camera.CFrame
		local camLook = safeUnit(Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z), Vector3.new(0, 0, -1))
		local camRight = safeUnit(Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z), Vector3.xAxis)
		return safeUnit(camLook * forward + camRight * right, camLook)
	end
	return Vector3.zero
end

local function isGrounded()
	if not RootPart or not Humanoid then return false end
	if Humanoid.FloorMaterial ~= Enum.Material.Air then
		return true
	end
	local ray = Workspace:Raycast(RootPart.Position, Vector3.new(0, -4.6, 0), getRayParams())
	return ray ~= nil
end

local function getCharacterMass()
	if not Character then return 15 end
	local total = 0
	for _, d in ipairs(Character:GetDescendants()) do
		if d:IsA("BasePart") and not d.Massless then
			total = total + d:GetMass()
		end
	end
	return math.max(total, 10)
end

local function addCameraShake(amount)
	if not SETTINGS.DynamicCameraFX then return end
	State.ShakeIntensity = math.max(State.ShakeIntensity, amount)
end

local function makeCharacterUpright()
	if not RootPart or not Humanoid then return end
	local flatLook = Vector3.new(RootPart.CFrame.LookVector.X, 0, RootPart.CFrame.LookVector.Z)
	if flatLook.Magnitude < 0.05 and Camera then
		flatLook = Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z)
	end
	flatLook = safeUnit(flatLook, Vector3.new(0, 0, -1))
	RootPart.CFrame = CFrame.lookAt(RootPart.Position, RootPart.Position + flatLook, Vector3.yAxis)
	RootPart.AssemblyAngularVelocity = Vector3.zero
	Humanoid.PlatformStand = false
	Humanoid.AutoRotate = true
end

