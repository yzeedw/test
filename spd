		for i = 1, 14 do
			local angle = (i / 14) * math.pi * 2
			local rayDir = Vector3.new(math.cos(angle), -0.25, math.sin(angle)).Unit
			local endP = curPos + rayDir * CONFIG.Gadgets.WebBombRadius
			local strand = Instance.new("Part")
