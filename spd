local function findNearestCombatTarget(maxRange)
	if not RootPart then return nil, nil end
	local origin = RootPart.Position
	local camLook = Camera.CFrame.LookVector
	local bestModel = nil
	local bestRoot = nil
	local bestScore = -math.huge

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Humanoid") and obj.Health > 0 and obj.Parent ~= Character then
			local model = obj.Parent
			local r = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
			if r then
				local toTarget = r.Position - origin
				local dist = toTarget.Magnitude
				if dist <= maxRange then
					local align = camLook:Dot(toTarget.Unit)
					if align > 0.35 or dist < 12 then
						local score = align * 50 - dist * 0.5
						if score > bestScore then
							bestScore = score
							bestModel = model
							bestRoot = r
						end
					end
				end
			end
		end
	end
	return bestModel, bestRoot
end

local function performCombatAttack()
	if not RootPart or not Humanoid then return end
	if not isCooldownReady("Combat") or State.IsAttacking then return end

	setCooldown("Combat", CONFIG.Combat.AttackCooldown)

	if (os.clock() - State.LastCombatTime) > CONFIG.Combat.ComboResetTime then
		State.ComboStep = 1
	end
	State.LastCombatTime = os.clock()

	local _, targetRoot = findNearestCombatTarget(CONFIG.Combat.WebStrikeRange)

	-- Ranged Web Strike Gap-Closer (Uses Custom WEB_ZIP_ANIM)
	if targetRoot and (targetRoot.Position - RootPart.Position).Magnitude > CONFIG.Combat.HitRange then
		State.IsAttacking = true
		local wristAtt = PhysicsObjects.RightWristAttachment or PhysicsObjects.RootAttachment
		local tempAtt = Instance.new("Attachment", targetRoot)
		local strikeBeam = createWebBeam(wristAtt, tempAtt, 0.20, 0.14)
		playWebSound(1.2)
		playWhooshSound(1.25)
		playAnim("WebZip", 0.05, 1.25)

		local startT = os.clock()
		while targetRoot and targetRoot.Parent and (os.clock() - startT) < 0.42 do
			local toEnemy = targetRoot.Position - RootPart.Position
			if toEnemy.Magnitude <= 6.5 then break end
			RootPart.AssemblyLinearVelocity = toEnemy.Unit * CONFIG.Combat.WebStrikeSpeed
			RunService.Heartbeat:Wait()
		end

		if strikeBeam then strikeBeam:Destroy() end
		if tempAtt then tempAtt:Destroy() end
		stopAnim("WebZip", 0.12)

		if targetRoot and targetRoot.Parent then
			playImpactSound(1.1)
			addCameraShake(0.48)
			spawnShockwaveRing(targetRoot.Position, (targetRoot.Position - RootPart.Position).Unit, 1.5, 10, 0.25, CONFIG.Visuals.WebGlowColor)
			targetRoot.AssemblyLinearVelocity = (RootPart.CFrame.LookVector * CONFIG.Combat.KnockbackForce) + Vector3.new(0, 26, 0)
			RootPart.AssemblyLinearVelocity = Vector3.new(0, 32, 0) - RootPart.CFrame.LookVector * 14
			performBodyFlip("Back")
		end
		State.IsAttacking = false
		return
	end

	-- Close-Quarters 4-Hit Combo
	State.IsAttacking = true
	local step = State.ComboStep
	State.ComboStep = (step % 4) + 1

	playSwooshSound(1.0 + step * 0.08)

	local forwardDir = safeUnit(Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z), RootPart.CFrame.LookVector)
	RootPart.CFrame = CFrame.lookAt(RootPart.Position, RootPart.Position + forwardDir)
	RootPart.AssemblyLinearVelocity = forwardDir * 24 + Vector3.new(0, (step == 4) and 28 or 4, 0)

	if step == 4 then
		performBodyFlip("Front")
	end

	local hitCenter = RootPart.Position + forwardDir * 5.5
	local hitColor = (step == 4 or State.IsSurgeActive) and CONFIG.Visuals.VenomColor or CONFIG.Visuals.WebGlowColor
	spawnShockwaveRing(hitCenter, forwardDir, 1.2, (step == 4) and 13 or 7.5, 0.22, hitColor)

	if step == 4 or State.IsSurgeActive then
		spawnLightningArc(RootPart.Position, hitCenter + Vector3.new(0, 2, 0), CONFIG.Visuals.VenomColor, 0.25, 0.22)
	end

	local parts = Workspace:GetPartBoundsInRadius(hitCenter, CONFIG.Combat.HitRange * 0.65)
	local hitAny = false
	for _, p in ipairs(parts) do
		if not p:IsDescendantOf(Character) and not p.Anchored then
			hitAny = true
			local knock = (step == 4) and CONFIG.Combat.FinisherKnockback or CONFIG.Combat.KnockbackForce
			p.AssemblyLinearVelocity = forwardDir * knock + Vector3.new(0, (step == 4) and 42 or 16, 0)
		end
	end
	if hitAny then
		playImpactSound(1.0 + step * 0.05)
		addCameraShake((step == 4) and 0.65 or 0.30)
	end

	task.delay(0.18, function()
		State.IsAttacking = false
	end)
end

